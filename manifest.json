{
  "manifest_version": 3,
  "name": "Shotgun",
  "version": "0.0.1",
  "minimum_chrome_version": "116",
  "description": "Claude as a browser companion",
  "permissions": [
    "debugger",
    "scripting",
    "storage",
    "activeTab",
    "tabs",
    "tabGroups",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [{
    "js": ["content/dom-reader.js"],
    "matches": ["<all_urls>"],
    "run_at": "document_start",
    "all_frames": true
  }]
}
